# ─── LLM (provider-agnostic, OpenAI-compatible) ───────────────────────────
# Groq is the default provider. Anything speaking /chat/completions works.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_llm_key_here
OPENAI_MODEL=openai/gpt-oss-120b
# Local dev: point at the opencode proxy and use any placeholder key
# OPENAI_BASE_URL=http://127.0.0.1:4096/v1
# OPENAI_API_KEY=local

# Extra Groq keys, rotated automatically on 429
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# ─── GitHub ────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token
# Required for webhooks. Without it, /api/v1/webhook rejects every request.
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ─── Storage ───────────────────────────────────────────────────────────────
# SQLite by default (zero infra); set a postgresql:// URL in production.
DATABASE_URL=sqlite+aiosqlite:///./buglens.db
# Engine state (idempotency, findings, feedback). Defaults next to the package.
BUGLENS_DB=
# Redis is optional; rate limits/budgets fall back to memory / no-op without it.
REDIS_URL=

# ─── Auth ──────────────────────────────────────────────────────────────────
ADMIN_API_KEY=change_me
# Optional. If unset, the IDE endpoints run unauthenticated (self-host default).
EXTENSION_SHARED_SECRET=

# ─── Misc ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
ENVIRONMENT=development

# ─── External context (optional) ───────────────────────────────────────────
# Opt in by listing providers in .buglens.yml under `external_context:`.
# A missing token is a silent no-op and a failed call never fails the review.
# jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
# linear
LINEAR_API_KEY=
# sentry (SENTRY_PROJECT and SENTRY_BASE_URL are optional)
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_BASE_URL=
# datadog (DD_SITE is optional)
DD_API_KEY=
DD_APP_KEY=
DD_SITE=
# posthog (POSTHOG_BASE_URL is optional, self-hosted)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_BASE_URL=
